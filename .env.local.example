# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Anthropic — AI insight generation (required in production; server-only)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional — Supabase service role for cron backup processing only
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — secure the cron endpoint on Vercel
# CRON_SECRET=your-random-secret

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AI_PROVIDER=anthropic
# INSIGHT_RATE_LIMIT_PER_HOUR=10
# INSIGHT_MAX_JOB_ATTEMPTS=3
# INSIGHT_POLL_INTERVAL_MS=3000
# INSIGHT_POLL_MAX_ATTEMPTS=20
# INSIGHT_POLL_TIMEOUT_MS=60000
# ONBOARDING_SAVE_TIMEOUT_MS=30000
# PHOTO_MAX_BYTES=5242880
# INSIGHT_PROCESSING_STALE_MS=120000
