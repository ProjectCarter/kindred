{
  "expo": {
    "name": "Kindred",
    "slug": "kindred",
    "scheme": "kindred",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FAF6EF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kindred.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kindred uses your location to show local weather, events, and news for your city."
      }
    },
    "android": {
      "package": "com.kindred.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kindred uses your location to show local weather, events, and news for your city."
        }
      ]
    ]
  }
}
