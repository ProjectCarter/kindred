{
  "name": "kindred",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:markets": "node --test lib/markets/*.test.ts",
    "test:generation": "node --test lib/edition/generationJobs.test.ts lib/edition/editionBuildStages.test.ts lib/edition/editionSectionOwnership.test.ts lib/edition/foodDrinksSection.test.ts lib/edition/foodDrinksHomepage.test.ts lib/edition/homepageDeskOrder.test.ts lib/edition/todayInHistoryImage.test.ts lib/edition/history/imageEventMatch.test.ts",
    "test:nationwide-audit": "node --test lib/edition/nationwideAudit.test.ts lib/edition/nationalNews.test.ts lib/edition/usNationalDaily.test.ts",
    "audit:nationwide": "npx --yes tsx scripts/nationwide-editorial-audit.ts",
    "check:mirror-sync": "node scripts/check-mirror-sync.mjs",
    "content:build-market": "node scripts/build-us-market.mjs",
    "content:sync-events": "node scripts/sync-events-catalog.mjs",
    "content:purge-unsafe-events": "node scripts/purge-family-unsafe-catalog-events.mjs",
    "content:enrich-events": "npx --yes deno run --allow-net --allow-env --allow-read scripts/enrich-events-catalog-editorial.ts",
    "content:build-nationwide": "node scripts/build-us-nationwide.mjs",
    "content:vault-sync-events": "node scripts/trigger-vault-edge.mjs sync-events",
    "content:vault-build-market": "node scripts/trigger-vault-build-market.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.2",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.7",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.1.10",
    "supabase": "^2.109.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
